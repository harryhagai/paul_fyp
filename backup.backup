<script>
// Real-time notification updates every 3 seconds
document.addEventListener('DOMContentLoaded', function() {
    // Update notifications immediately and then every 3 seconds
    updateNotifications();
    setInterval(updateNotifications, 3000);
});

// Manual test functions for debugging (can be called from browser console)
window.testNotifications = function() {
    console.log('Manually testing notifications...');
    updateNotifications();
};

window.testBadge = function(count) {
    console.log('Manually testing badge with count:', count);
    updateNotificationBadge(count);
};

function updateNotifications() {
    $.ajax({
        url: '/api/notifications/unread-count',
        type: 'GET',
        dataType: 'json',
        success: function(data) {
            updateNotificationBadge(data.count);
            updateNotificationDropdown();
        },
        error: function(xhr, status, error) {
            console.error('Error updating notifications:', error);
        }
    });
}

function updateNotificationBadge(count) {
    const countText = count > 99 ? '99+' : count;
    const badge = document.getElementById('notification-badge');
    const sidebarBadge = document.getElementById('sidebar-notification-badge');

    if (count > 0) {
        // Show/update header badge
        if (badge) {
            badge.textContent = countText;
            badge.style.display = 'inline-block';
        }

        // Show/update sidebar badge
        if (sidebarBadge) {
            sidebarBadge.textContent = countText;
            sidebarBadge.style.display = 'inline-block';
        }
    } else {
        // Hide badges when count is 0
        if (badge) {
            badge.style.display = 'none';
        }
        if (sidebarBadge) {
            sidebarBadge.style.display = 'none';
        }
    }
}

function updateNotificationDropdown() {
    // Fetch recent notifications
    $.ajax({
        url: '/api/notifications/recent',
        type: 'GET',
        dataType: 'json',
        success: function(data) {
            const dropdownMenu = document.querySelector('.notification-dropdown');
            if (!dropdownMenu) return;

            // Update the notification items (keep header and footer)
            const existingItems = dropdownMenu.querySelectorAll('li:not(.dropdown-header)');
            existingItems.forEach(item => {
                // Keep only items that contain "View All" in the link text
                const link = item.querySelector('a');
                if (!link || !link.textContent.includes('View All')) {
                    item.remove();
                }
            });

            // Insert new notifications before the "View All" link
            const viewAllLink = dropdownMenu.querySelector('a');
            let viewAllLi = null;
            if (viewAllLink && viewAllLink.textContent.includes('View All')) {
                viewAllLi = viewAllLink.closest('li');
            }
            if (viewAllLink && data.notifications && data.notifications.length > 0) {
                data.notifications.forEach(notification => {
                    const li = document.createElement('li');
                    li.innerHTML = `
                        <a class="dropdown-item ${notification.read_at ? '' : 'unread'}" href="/seller/notifications/${notification.id}">
                            <div class="d-flex">
                                <div class="flex-grow-1">
                                    <div class="fw-bold">${notification.title}</div>
                                    <small class="text-muted">${notification.message.length > 50 ? notification.message.substring(0, 50) + '...' : notification.message}</small>
                                    <br>
                                    <small class="text-muted">${new Date(notification.created_at).toLocaleString()}</small>
                                </div>
                                ${!notification.read_at ? '<div class="ms-2"><span class="badge bg-primary rounded-pill">New</span></div>' : ''}
                            </div>
                        </a>
                    `;
                    viewAllLink.parentNode.before(li);
                });
            }
        },
        error: function(xhr, status, error) {
            console.error('Error updating notification dropdown:', error);
        }
    });
}




</script>
